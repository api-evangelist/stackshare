{
  "@context": {
    "@vocab": "https://schema.org/",
    "stackshare": "https://stackshare.io/schema/",
    "Tool": {
      "@id": "schema:SoftwareApplication",
      "@type": "@id"
    },
    "Company": {
      "@id": "schema:Organization",
